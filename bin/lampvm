#!/usr/bin/env python3
"""A shell interface to an isolated macOS desktop. No host GUI automation."""
import argparse
import contextlib
import fcntl
import json
import math
import os
from pathlib import Path
import re
import shlex
import socket
import subprocess
import sys
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from bootstrap import complete_desktop
from slots import Slots, flock_file


class Error(Exception):
    pass


def run(argv, **kwargs):
    # Cloning must not silently prune another session's cached images.
    kwargs.setdefault("env", {**os.environ, "TART_NO_AUTO_PRUNE": "1"})
    result = subprocess.run([str(x) for x in argv], **kwargs)
    if result.returncode:
        raise Error("command failed (exit %s)" % result.returncode)
    return result


def output(argv):
    return run(argv, stdout=subprocess.PIPE, text=True).stdout.strip()


def reachable(host, port):
    try:
        with socket.create_connection((host, port), timeout=3):
            return True
    except OSError:
        return False


# A VM made before the helper could glide keeps its helper for life. Its helper answers `version`
# with a failure, so a recording there is driven as before instead of failing on an option it lacks.
GLIDING = r'''helper="$HOME/.local/bin/vmctl"; why=$1; shift
version=$("$helper" version 2>/dev/null) || version=1
if [[ $version == <-> && $version -ge 2 ]]; then exec "$helper" "$@" --glide; fi
if [[ $why == asked ]]; then print -u2 "This VM's guest helper is older than --glide. Clone a VM from a clean image prepared with the current helper."; exit 2; fi
exec "$helper" "$@"'''
RECORDER = r"/vmctl record /tmp/lampvm-[0-9a-f]+\.mov( |$)"
RECORD_LIMIT = 3600


def timeline_for(movie):
    # take.mov's marks live in take.timeline.json beside it.
    return movie.with_name(movie.stem + ".timeline.json")
PAUSE = "%%s /tmp/lampvm-record-paused && exec /usr/bin/pkill -USR1 -f %s" % shlex.quote(RECORDER)
GLIDE = "move the pointer to the target smoothly; always on while this VM is being recorded"


def valid_name(name):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,79}", name):
        raise Error("VM names must use letters, numbers, dot, dash or underscore (max 80)")
    return name


@contextlib.contextmanager
def lock(path, timeout=120):
    path.parent.mkdir(parents=True, exist_ok=True)
    deadline = time.monotonic() + timeout
    while True:
        handle = flock_file(path)
        if handle:
            break
        if time.monotonic() >= deadline:
            raise Error("VM is busy; lock wait timed out")
        time.sleep(0.1)
    with handle:  # Closing releases the lock.
        yield


def valid_session(session):
    # One token, so it stays the same on every start; --owner carries the prose.
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,79}", session):
        raise Error("--session must be one task or thread id: letters, numbers, dot, dash, colon or underscore (max 80)")
    return session


def prompt_from_tree(tree):
    # `vmctl tree` lines are ROLE, POSITION, SIZE and LABEL; AppKit appends internal names such as "_NS:73" to labels.
    text, buttons = [], []
    for line in tree.splitlines():
        parts = line.split("\t")
        if len(parts) < 4:
            continue
        label = " | ".join(part for part in parts[3].split(" | ") if not re.fullmatch(r"_NS:\d+|infotext", part))
        if parts[0] == "AXStaticText" and label:
            text.append(label)
        elif parts[0] == "AXButton" and label:
            buttons.append(label)
    return {"text": text, "buttons": buttons} if tree.startswith("AXWindow") else None


def banners_from_tree(items):
    # Notification Center has a window titled "Notification Center" only while a notification, or its panel, shows.
    # Each notification is a labelled group in it; failing that, its text; failing that, the whole window counts.
    found = []
    for window in [e for e in items if e["role"] == "AXWindow" and e["label"] == "Notification Center" and e.get("bounds")]:
        inside = [e for e in items if e["path"].startswith(window["path"] + ".") and e.get("bounds") and e["bounds"]["width"] > 0]
        cells = [e for e in inside if e["role"] == "AXGroup" and e["label"] and e["label"] != "widgets-overlay-view"]
        texts = [e for e in inside if e["role"] in ("AXStaticText", "AXButton", "AXImage")]
        found += [{"bounds": e["bounds"], "text": e["label"].split(" | ")[0]} for e in cells or texts] or [{"bounds": window["bounds"], "text": "a notification"}]
    return found


def overlaps(a, b):
    return a["x"] < b["x"] + b["width"] and b["x"] < a["x"] + a["width"] and a["y"] < b["y"] + b["height"] and b["y"] < a["y"] + a["height"]


def ocr_target(lines, text, exact=False, index=None, scale=2.0, area="the screen"):
    # OCR boxes are in image pixels; the click point is in screen points from the captured area's corner.
    wanted = text.lower()
    found = [line for line in lines if line["text"].strip().lower() == wanted]
    # Whole words only: "Me" must not match the "em" inside "element".
    words = re.compile(r"(?<!\w)" + re.escape(wanted) + r"(?!\w)", re.IGNORECASE)
    if not exact and not found:
        found = [line for line in lines if words.search(line["text"])]
    found.sort(key=lambda line: (round(line["bounds"]["y"] / 10), line["bounds"]["x"]))
    if not found:
        raise Error("No text in %s reads %r%s. Read: %s" % (area, text, "; for another window use --window TITLE" if area.startswith("the front") else "",
                                                          ", ".join(repr(line["text"]) for line in lines[:30])))
    if index is None and len(found) > 1:
        raise Error("%d places read %r; choose one with --index N (from the top): %s" % (len(found), text, ", ".join(repr(line["text"]) for line in found)))
    if index is not None and not 0 <= index < len(found):
        raise Error("--index must be below %d" % len(found))
    line = found[index or 0]
    box = line["bounds"]
    # Inside a longer line, aim at the words' share of the box; Vision gives the line's box, not each word's.
    match = words.search(line["text"])
    start = match.start() if match else -1
    middle = (start + len(wanted) / 2) / len(line["text"]) if start >= 0 and len(line["text"]) else 0.5
    return {"text": line["text"], "confidence": round(line.get("confidence", 0), 2),
            "x": (box["x"] + box["width"] * middle) / scale, "y": (box["y"] + box["height"] / 2) / scale}


@contextlib.contextmanager
def locks(state, names):
    # Every lifecycle operation takes the same sorted order, including its source.
    with contextlib.ExitStack() as stack:
        for name in sorted(set(names)):
            stack.enter_context(lock(state / "locks" / (valid_name(name) + ".lock")))
        yield


class VM:
    def __init__(self, args):
        self.state = Path(args.state_dir or os.environ.get("LAMPVM_STATE_DIR", "~/Library/Application Support/lampvm")).expanduser().resolve()
        config_path = Path(args.config or os.environ.get("LAMPVM_CONFIG", str(self.state / "config.json"))).expanduser()
        runtime = self.state / "config.json"
        self.config = json.loads(runtime.read_text()) if runtime.exists() else {}
        if not isinstance(self.config, dict):
            raise Error("Runtime configuration must be a JSON object")
        if (args.config or os.environ.get("LAMPVM_CONFIG")) and not config_path.is_file():
            raise Error("Configuration file does not exist: " + str(config_path))
        overlay = {}
        if config_path.exists() and config_path.resolve() != runtime.resolve():
            overlay = json.loads(config_path.read_text())
            if not isinstance(overlay, dict):
                raise Error("Configuration must be a JSON object")
            self.config.update(overlay)
        self.name = valid_name(args.name or os.environ.get("LAMPVM_NAME") or self.config.get("vm", "lampvm"))
        self.clean = valid_name(self.config.get("clean", "lampvm-clean"))
        # A flag outranks the environment: `--config` naming an app, or `{"app": null}` for the
        # whole desktop, beats LAMPVM_APP, which beats the app of LAMPVM_CONFIG or runtime state.
        if getattr(args, "app", None):
            self.app = args.app
        elif args.config and "app" in (overlay if config_path.resolve() != runtime.resolve() else self.config):
            self.app = self.config.get("app")
        else:
            self.app = os.environ.get("LAMPVM_APP") or self.config.get("app")
        self.tart = Path(os.environ.get("LAMPVM_TART", str(self.state / "tart/tart.app/Contents/MacOS/tart"))).expanduser()
        self.ctl = None

    def require_tart(self):
        if not self.tart.is_file():
            raise Error("Tart is missing; run lampvm setup")

    def t(self, *args, **kwargs):
        self.require_tart()
        return run([self.tart, *args], **kwargs)

    def tout(self, *args):
        self.require_tart()
        return output([self.tart, *args])

    def machines(self):
        return json.loads(self.tout("list", "--format", "json"))

    def exists(self, name):
        return any(v["Name"] == name and v.get("Source") == "local" for v in self.machines())

    def running(self):
        return any(v["Name"] == self.name and v.get("Source") == "local" and v.get("Running") for v in self.machines())

    def marker(self, name=None):
        return self.state / "vms" / (valid_name(name or self.name) + ".json")

    def owned(self):
        if not self.marker().is_file():
            raise Error("This VM has no lampvm ownership record. Use setup or clone; existing VMs are never adopted automatically.")
        marker = json.loads(self.marker().read_text())
        if not isinstance(marker, dict) or marker.get("name") != self.name:
            raise Error("Ownership record does not match the selected VM")

    def working(self):
        self.owned()
        if json.loads(self.marker().read_text()).get("role") == "clean":
            raise Error("Clean snapshots cannot be started, reset or destroyed with working-VM commands")

    def need(self):
        self.owned()
        if not self.running():
            raise Error("VM isn't running; run lampvm start")

    def guest(self, *args, **kwargs):
        return self.t("exec", self.name, *args, **kwargs)

    def gout(self, *args):
        return self.tout("exec", self.name, *args)

    def health(self):
        issues = []
        record = json.loads(self.marker().read_text())
        if "panic_reports" in record:
            source = 'for report in /Library/Logs/DiagnosticReports/*panic*(N) "$HOME"/Library/Logs/DiagnosticReports/*panic*(N); do [[ ! -f "$report" ]] || print -r -- "$report"; done'
            reports = set(self.gout("/bin/zsh", "-c", source).splitlines())
            if reports - set(record["panic_reports"]):
                issues.append("guest has new kernel panic reports; inspect its DiagnosticReports before testing")
        reporter = subprocess.run([str(self.tart), "exec", self.name, self.helper(), "tree", "Diagnostics Reporter"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=15)
        if "restarted" in reporter.stdout.lower() and "problem" in reporter.stdout.lower():
            issues.append("guest displays a restart error; inspect it before testing")
        assistant = subprocess.run([str(self.tart), "exec", self.name, self.helper(), "windows", "com.apple.SetupAssistant"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=15)
        if assistant.returncode == 0 and json.loads(assistant.stdout):
            issues.append("Setup Assistant is still open; complete setup before testing")
        return issues

    def helper(self):
        if self.ctl is None:
            self.ctl = self.gout("/bin/zsh", "-c", 'print -r -- "$HOME/.local/bin/vmctl"')
            if not self.ctl.startswith("/"):
                raise Error("Guest did not report an absolute vmctl path")
        return self.ctl

    def control(self, *args, capture=False, glide=None):
        # One guest call per command: asking for the helper's path first doubles the wait.
        if glide:
            return self.guest("/bin/zsh", "-c", GLIDING, "vmctl", glide, *args)
        command = [self.ctl] if self.ctl else ["/bin/zsh", "-c", 'exec "$HOME/.local/bin/vmctl" "$@"', "vmctl"]
        return self.gout(*command, *args) if capture else self.guest(*command, *args)

    def helper_version(self):
        # A helper from before `version` answers it with its usage and a failure.
        result = subprocess.run([str(self.tart), "exec", self.name, self.helper(), "version"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        text = result.stdout.strip()
        return int(text) if result.returncode == 0 and text.isdigit() else 1

    def signal_recording(self, action):
        self.need()
        # The helper closes its movie on an interrupt; each waiting record call then copies it out.
        # Pause and resume are user signals, which end a helper older than them without saving its movie.
        # Repeated user signals merge, so the helper reads whether to pause from a file, not from their order.
        state, version, command = {"stop": ("stopping", 3, ["/usr/bin/pkill", "-INT", "-f", RECORDER]),
                                   "pause": ("paused", 4, ["/bin/zsh", "-c", PAUSE % "/usr/bin/touch"]),
                                   "resume": ("recording", 4, ["/bin/zsh", "-c", PAUSE % "/bin/rm -f"])}[action]
        if version > 3 and self.helper_version() < version:
            raise Error("This VM's guest helper cannot pause a recording. Clone a VM from a clean image prepared with the current helper.")
        if subprocess.run([str(self.tart), "exec", self.name, *command]).returncode == 0:
            if action != "stop":
                self.mark_paused(action == "pause")
            print(json.dumps({"vm": self.name, "recording": state}))
        elif version == 3 and self.helper_version() < 3:
            raise Error("This VM's guest helper cannot end a recording early; it runs for its --seconds. Clone a VM from a clean image prepared with the current helper.")
        else:
            raise Error("No recording is running in this VM")

    def mark_recording(self, text):
        # The helper notes the moment on the guest's own clock, the one its frames are timed by, so the mark lands where it was made.
        self.need()
        text = " ".join(text.split())
        if not text:
            raise Error("--mark needs some words")
        if not self.recordings(self.name):
            raise Error("No recording is running in this VM")
        if self.helper_version() < 6:
            raise Error("This VM's guest helper cannot mark a recording. Clone a VM from a clean image prepared with the current helper.")
        self.control("mark", text)

    def recording(self):
        (self.state / "locks").mkdir(parents=True, exist_ok=True)
        return self.state / "locks" / (self.name + "-recording.lock")

    def glide(self, args):
        # A pointer that jumps is unreadable in a video; outside one the jump is faster.
        if getattr(args, "glide", False):
            return "asked"
        handle = flock_file(self.recording())
        if handle:
            handle.close()
        return None if handle else "recording"

    def openrouter(self, app=None, model=None):
        # Live AI turns cost real money on the person's key, so the configured model is the
        # one every session gets unless it names another. Only the openrouter entry leaves the
        # host, through standard input: never in an argument, a host temp file or the output.
        setting = self.config.get("openrouter", {})
        apps = setting.get("apps", {})
        app = app or next(iter(apps), None)
        if app not in apps or not re.fullmatch(r"[A-Za-z0-9._-]+", apps[app]):
            raise Error("No openrouter preference domain configured for app: %s" % app)
        model = model or setting.get("model")
        if not model or not re.fullmatch(r"[A-Za-z0-9._:/-]+", model):
            raise Error("Configure openrouter.model or pass --model as a provider/model id")
        keys = Path(setting.get("keys") or "~/Library/Application Support/Lamp Dev/keys.json").expanduser()
        try:
            key = json.loads(keys.read_text()).get("openrouter")
        except (OSError, ValueError, AttributeError):
            key = None
        if not isinstance(key, str) or not key.strip():
            raise Error("No openrouter key in %s; nothing pushed" % keys)
        self.control("quit", app)
        script = '''set -eu
umask 077
mkdir -p -- "$HOME/Library/Application Support/$1"
/bin/cat > "$HOME/Library/Application Support/$1/keys.json"
/usr/bin/defaults write "$2" onboarded -bool true
/usr/bin/defaults write "$2" engine pi
/usr/bin/defaults write "$2" piProvider openrouter
/usr/bin/defaults write "$2" piModel.openrouter "$3"
'''
        self.t("exec", "-i", self.name, "/bin/zsh", "-c", script, "lampvm", app, apps[app], model,
               input=json.dumps({"openrouter": key.strip()}), text=True)
        print("%s builds with openrouter %s" % (app, model))

    def application(self, explicit=None):
        app = explicit or self.app
        if not app:
            raise Error("Specify APP or configure app; there is no app-specific default")
        return app

    def start(self, wait_seconds, owner=None, idle_after=600, detach=False, session=None):
        self.working()
        slots = Slots(self.state)
        already_running = self.running()
        existing = slots.snapshot()['requests'].get(self.name)
        if already_running and (not existing or existing['phase'] not in ('running', 'failed', 'booting', 'queued')):
            print("already running: " + self.name + "; activity untracked until next managed start")
            return
        # Do not let an immediate start jump ahead of durable waiters.
        # Durable waits are saved immediately, even while another VM boots.
        # Only a no-wait admission needs a host capacity check here.
        admission = lock(self.state / "locks/host-start.lock", timeout=0) if not wait_seconds and not already_running else contextlib.nullcontext()
        with admission:
            existing = slots.snapshot()['requests'].get(self.name)
            resuming = existing and (existing['phase'] == 'booting' or
                                     existing['phase'] == 'queued' and existing['expires_at'] > time.time())
            if not wait_seconds and not resuming and not already_running:
                if slots.waiting(slots.snapshot(), time.time()) or sum(
                        bool(v.get("Running")) for v in self.machines() if v.get("Source") == "local") >= 2:
                    raise Error("Slots busy or queued; use start --wait SECONDS; status shows holders and line")
            request = existing if already_running else slots.enqueue(
                self.name, wait_seconds or 30, owner or self.name, self.config, self.tart, idle_after, session)
            if not request.get('session') and not (existing and existing['id'] == request['id']):
                print("note: no --session (or LAMPVM_SESSION) task/thread id; status cannot group this VM with its session",
                      file=sys.stderr, flush=True)
        logfile = self.launch_worker(request)
        launched = time.time()
        print("ticket: " + request['id'] + "; log: " + str(logfile), flush=True)
        if detach:
            return
        previous = None
        while True:
            data = slots.snapshot()
            current = data['requests'].get(self.name)
            if not current or current['id'] != request['id']:
                raise Error("Start request replaced or removed; inspect status")
            phase = current['phase']
            if phase == 'running':
                print("running: " + self.name)
                return
            if phase in ('failed', 'expired', 'cancelled', 'stopped'):
                raise Error("Start " + phase + ": " + current.get('error', 'see status and ' + str(logfile)))
            queue = slots.waiting(data, time.time())
            position = next((i for i, r in enumerate(queue, 1) if r['id'] == request['id']), None)
            message = (phase, position)
            if message != previous:
                print("start %s; queue position %s; waited %.0fs; expires in %.0fs; ETA unknown" %
                      (phase, position or '-', time.time()-request['enqueued_at'],
                       max(0, request['expires_at']-time.time())), file=sys.stderr, flush=True)
                previous = message
            # A resumed ticket's last heartbeat is its dead worker's; time the new one from its launch.
            heartbeat = max(current.get('heartbeat') or request['enqueued_at'], launched)
            if time.time() - heartbeat > (240 if phase == 'booting' else 30):
                raise Error("Detached worker stalled; rerun start to resume the same ticket/place")
            time.sleep(1)

    def launch_worker(self, request):
        """Start the ticket's detached worker; one that finds a live worker for it exits."""
        logdir = self.state / "logs"
        logdir.mkdir(parents=True, exist_ok=True)
        logfile = logdir / (self.name + "-slot-" + request['id'] + ".log")
        Slots(self.state).update_request(self.name, request['id'], log=str(logfile))
        with logfile.open('ab') as stream:
            subprocess.Popen([sys.executable, str(ROOT / "lib/slots_worker.py"),
                              str(self.state), self.name, request['id']],
                             stdin=subprocess.DEVNULL, stdout=stream, stderr=subprocess.STDOUT,
                             start_new_session=True)
        return logfile

    def reset(self, clean):
        """Called with the lifecycle locks of this VM and its clean source held."""
        slots = Slots(self.state)
        replace = lambda: (self.t("delete", self.name), self.t("clone", clean, self.name))
        request = slots.snapshot()['requests'].get(self.name)
        if not (request and request['phase'] in ('running', 'failed') and self.running()):
            # No slot to keep. A queued ticket keeps its place: its worker boots the new copy.
            self.stop()
            slots.stopped(self.name)
            replace()
            print("reset (stopped): " + self.name)
            return
        # Holding host-start admits nobody into the slot this VM leaves for a moment.
        # Every step below is bounded, and a reset that fails ends without the slot.
        with lock(self.state / "locks/host-start.lock", timeout=300), slots.activity(self.name, "reset"):
            slots.update_request(self.name, request['id'], phase='booting', heartbeat=time.time())
            try:
                self.stop()
                replace()
                self.ctl = None
                self.boot()
            except BaseException as error:
                if self.running():
                    slots.update_request(self.name, request['id'], phase='failed', error=str(error))
                else:
                    slots.stopped(self.name)
                raise
            slots.restarted(self.name, request['id'])
        self.launch_worker(request)
        print("reset (running, slot kept): " + self.name)

    def boot(self, on_launch=lambda: None):
        """Called only with the VM lifecycle and host-start locks held."""
        self.working()
        proc = None
        logfile = self.state / "logs"
        if not self.running():
            logfile.mkdir(parents=True, exist_ok=True)
            logfile = logfile / (self.name + "-" + uuid.uuid4().hex + ".log")
            with logfile.open("wb") as stream:
                proc = subprocess.Popen([str(self.tart), "run", "--no-graphics", "--no-audio", "--no-clipboard", self.name], stdin=subprocess.DEVNULL, stdout=stream, stderr=subprocess.STDOUT, start_new_session=True)
        on_launch()
        boot_deadline = time.monotonic() + 120
        while time.monotonic() < boot_deadline:
            if proc is not None and proc.poll() is not None:
                raise Error("Tart exited during boot; inspect " + str(logfile))
            try:
                ready = subprocess.run([str(self.tart), "exec", self.name, "/usr/bin/pgrep", "-q", "Dock"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            except subprocess.TimeoutExpired:
                ready = None
            if ready and ready.returncode == 0:
                self.control("trusted", capture=True)
                complete_desktop(self.tart, self.name, self.helper())
                issues = self.health()
                if issues:
                    raise Error("; ".join(issues) + "; the owned VM remains running for inspection")
                return
            time.sleep(1)
        raise Error("Boot timed out; inspect " + str(logfile) + "; the owned VM may still be running")

    def stop(self):
        self.owned()
        if not self.running():
            print("already stopped: " + self.name)
            return
        subprocess.run([str(self.tart), "exec", self.name, "/usr/bin/sudo", "-n", "/sbin/shutdown", "-h", "now"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(40):
            if not self.running():
                print("stopped: " + self.name)
                return
            time.sleep(1)
        self.t("stop", self.name)
        print("stopped (forced): " + self.name)

    def view(self, explicit=None):
        """Open the guest desktop for a person. Never touches slot activity or locks."""
        if explicit:
            self.name = valid_name(explicit)
        else:
            running = sorted(v["Name"] for v in self.machines() if v.get("Source") == "local" and v.get("Running") and self.marker(v["Name"]).is_file())
            if not running:
                raise Error("No VM is running, so there is nothing to look at. An agent starts one with lampvm start; lampvm status lists them.")
            if len(running) > 1:
                raise Error("More than one VM is running. Choose one:\n" + "\n".join("  lampvm view " + name for name in running))
            self.name = running[0]
        self.need()
        address = self.tout("ip", self.name)
        if not re.fullmatch(r"[0-9.]+", address):
            raise Error("Tart reported no usable address for " + self.name)
        if not reachable(address, 5900):
            raise Error("Screen Sharing is off in this guest (port 5900 closed); enable it in the guest's Sharing settings")
        user, password = self.config.get("user", "admin"), self.config.get("password", "admin")
        run(["/usr/bin/open", "vnc://%s:%s@%s" % (user, password, address)])
        helper = self.state / "bin/lockstate"
        if helper.exists() and output([helper]) == "locked":
            print("This Mac's screen is locked; the window appears once you unlock it.")
        print("Opening %s in Screen Sharing. If it asks for a type, keep Standard and click Continue.\n"
              "Guest login if asked: %s / %s. You share one pointer and keyboard with the agent using this VM.\n"
              "Close the window when done; the VM keeps running." % (self.name, user, password))

    def push(self, source, dest):
        src = Path(source).expanduser().resolve()
        if not src.exists():
            raise Error("Source doesn't exist")
        script = 'mkdir -p -- "$1" && /usr/bin/tar -xf - -C "$1"'
        self.pipe_tar(src, script, dest)

    def pipe_tar(self, src, script, *args):
        tar = subprocess.Popen(["/usr/bin/tar", "-C", str(src.parent), "-cf", "-", "--", src.name], stdout=subprocess.PIPE)
        try:
            result = subprocess.run([str(self.tart), "exec", "-i", self.name, "/bin/zsh", "-c", script, "lampvm", *args], stdin=tar.stdout)
        finally:
            tar.stdout.close()
            status = tar.wait()
        if result.returncode or status:
            raise Error("File transfer failed")

    def recordings_dir(self):
        path = self.state / "recordings"
        path.mkdir(parents=True, exist_ok=True)
        return path

    def recordings(self, name=None):
        # One file per running `record` call; a call that died without removing its file is forgotten here.
        found = []
        for entry in sorted(self.recordings_dir().glob("*.json")):
            try:
                record = json.loads(entry.read_text())
            except (OSError, ValueError):
                continue
            # A file this code did not write whole is skipped, so one bad file cannot break status for every session.
            if not (isinstance(record, dict) and type(record.get("pid")) is int and record["pid"] > 0 and isinstance(record.get("vm"), str)
                    and isinstance(record.get("started_at"), (int, float)) and isinstance(record.get("file"), str)):
                continue
            try:
                os.kill(record["pid"], 0)
            except ProcessLookupError:
                entry.unlink(missing_ok=True)
                continue
            except OSError:
                pass  # Alive, but another user's process.
            if name is None or record["vm"] == name:
                record["running_seconds"] = round(time.time() - record["started_at"])
                record.setdefault("limit_seconds", None); record.setdefault("paused", False)
                record.setdefault("app", None); record.setdefault("window", None)
                found.append(record)
        return found

    def mark_paused(self, paused):
        for entry in self.recordings_dir().glob("*.json"):
            with contextlib.suppress(OSError, ValueError):
                record = json.loads(entry.read_text())
                if record.get("vm") == self.name:
                    record["paused"] = paused
                    entry.write_text(json.dumps(record) + "\n")

    def system_prompt(self):
        # Password and Keychain prompts are SecurityAgent windows. They wait for a person, so a command behind one never ends.
        try:
            result = subprocess.run([str(self.tart), "exec", self.name, self.helper(), "tree", "SecurityAgent"], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True, timeout=20)
        except subprocess.TimeoutExpired:
            return None  # A slow look is no evidence of a prompt; the command keeps running.
        return prompt_from_tree(result.stdout) if result.returncode == 0 else None

    def watched(self, *argv, **kwargs):
        # Runs a guest command, looking every two seconds for a system prompt it may be waiting on.
        # A prompt already open when the command starts is not its doing, so only one that opens afterwards stops the wait.
        # The look has to finish first: a command can open its own prompt within a fraction of a second.
        before = self.system_prompt()
        process = subprocess.Popen([str(self.tart), *argv], env={**os.environ, "TART_NO_AUTO_PRUNE": "1"}, **kwargs)
        try:
            prompt = self.wait_or_prompt(process, before)
        except BaseException:
            # Interrupted: end the host side of the command, as subprocess.run does.
            process.kill()
            process.wait()
            raise
        if prompt:
            process.terminate()
            with contextlib.suppress(subprocess.TimeoutExpired):
                process.wait(timeout=5)
            print(json.dumps({"vm": self.name, "prompt": "SecurityAgent", **prompt}))
            raise Error("A system prompt is waiting in the guest: " + " ".join(prompt["text"]) + "\nlampvm stopped waiting; the guest "
                        "command may still be waiting on the prompt. A person can answer it through `lampvm view`; to refuse it, press " +
                        " or ".join("`lampvm press SecurityAgent %s --exact`" % b for b in prompt["buttons"] if b in ("Cancel", "Deny")) + ".")
        if process.returncode:
            raise Error("command failed (exit %s)" % process.returncode)

    def wait_or_prompt(self, process, before):
        while True:
            try:
                process.wait(timeout=2)
                return None
            except subprocess.TimeoutExpired:
                pass
            prompt = self.system_prompt()
            if prompt and prompt != before:
                return prompt
            if not prompt:
                before = None  # Once the earlier prompt is gone, the same prompt opening again is new.

    def find_window(self, title, app=None):
        # Every app's windows in one guest call; an explicit --app narrows the search.
        owners = [(app, app)] if app else [(a["bundleIdentifier"] or a["name"], a["name"]) for a in json.loads(self.control("apps", capture=True))]
        script = 'h="$HOME/.local/bin/vmctl"; for a in "$@"; do print -r -- "$("$h" windows "$a" 2>/dev/null || print "[]")"; done'
        listed = self.gout("/bin/zsh", "-c", script, "lampvm", *[key for key, _ in owners]).splitlines()
        windows = [(key, name, window) for (key, name), line in zip(owners, listed) for window in json.loads(line or "[]") if "bounds" in window]
        if not title.strip():
            raise Error("--window needs a title")
        exact = [entry for entry in windows if entry[2]["title"] == title]
        found = exact or [entry for entry in windows if title.lower() in entry[2]["title"].lower()]
        if len(found) != 1:
            titles = sorted({"%s (%s)" % (window["title"], name) for _, name, window in (found or windows) if window["title"]})
            raise Error(("No window is titled " if not found else "More than one window matches ") + repr(title) +
                        ". Windows: " + ", ".join(titles))
        key, name, window = found[0]
        rect = window["bounds"]
        x, y = math.floor(rect["x"]), math.floor(rect["y"])
        bounds = "%d,%d,%d,%d" % (x, y, math.ceil(rect["x"] + rect["width"]) - x, math.ceil(rect["y"] + rect["height"]) - y)
        return dict(key=key, app=name, title=window["title"], bounds=bounds)

    def show_window(self, window):
        # The named window comes forward and becomes main, so a crop shows it and its first click counts. A helper
        # older than 5 cannot raise one window: its app comes forward and the window may stay behind the app's others.
        raised = self.helper_version() >= 5
        shown = json.loads(self.control(*(["raise", window["key"], window["title"]] if raised else ["activate", window["key"]]), capture=True))
        # Some windows, such as desktop widgets, cannot come forward. A capture of one that another app covers would
        # show that app. Helper 5 lists the windows on screen front to back, which finds any overlap; an older one can
        # only look at five points inside the window, and misses a cover that falls between them.
        x, y, width, height = map(int, window["bounds"].split(","))
        if raised:
            stack = json.loads(self.control("onscreen", capture=True))
            target = next((i for i, w in enumerate(stack) if w["pid"] == shown["pid"] and w["title"] == window["title"]), None)
            if target is None:
                raise Error("The window %r is not on screen" % window["title"])
            # The menu bar, Dock and notification layers (20 and up) span the screen though they draw little of it;
            # notification banners are checked on their own.
            covering = {w["pid"] for w in stack[:target] if w["pid"] != shown["pid"] and w["layer"] < 20 and w["alpha"] > 0
                        and overlaps(w["bounds"], {"x": x, "y": y, "width": width, "height": height})}
        else:
            points = [(x + width * fx, y + height * fy) for fx, fy in ((0.5, 0.5), (0.15, 0.15), (0.85, 0.15), (0.15, 0.85), (0.85, 0.85))]
            script = 'h="$HOME/.local/bin/vmctl"; while (( $# )); do "$h" hit "$1" "$2" 2>/dev/null || print "{}"; shift 2; done'
            hits = [json.loads(line) for line in self.gout("/bin/zsh", "-c", script, "lampvm", *["%.0f" % v for point in points for v in point]).splitlines()]
            covering = {hit["pid"] for hit in hits if hit.get("hit") and hit.get("pid", -1) > 0} - {shown["pid"]}
        if covering:
            names = [a["name"] for a in json.loads(self.control("apps", capture=True)) if a["pid"] in covering] or ["another window"]
            raise Error("The window %r is covered by %s, so a capture would show that instead. Move or close it, then retry." %
                        (window["title"], ", ".join(names)))
        return raised

    def banners(self):
        try:
            result = subprocess.run([str(self.tart), "exec", self.name, self.helper(), "tree", "com.apple.notificationcenterui", "--json"],
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=20)
        except subprocess.TimeoutExpired:
            raise Error("Could not read Notification Center to rule out a notification banner over the capture; retry")
        return banners_from_tree(json.loads(result.stdout)) if result.returncode == 0 else []  # Not running: nothing shows.

    def refuse_banners(self, region):
        # A banner over the captured area would put its text, often private, into the picture.
        area = dict(zip(("x", "y", "width", "height"), map(int, region.split(",")))) if region else None
        shown = [b for b in self.banners() if area is None or overlaps(b["bounds"], area)]
        if shown:
            raise Error("A notification is on screen over the capture area (%s), so the capture would show it. Wait for it to go, or dismiss it "
                        "(a person can through `lampvm view`), then retry." % "; ".join(repr(b["text"][:80]) for b in shown))

    def ocr_click(self, app, text, args):
        # For what Accessibility cannot see, such as a web page's own buttons: read the screen and click the words.
        region, owner, raised = None, app, None
        if args.window is not None:
            window = self.find_window(args.window, args.app)
            region, owner, raised = window["bounds"], None, self.show_window(window)
        elif app:
            self.control("activate", app)
            region = self.control("bounds", app, capture=True)
        remote = "/tmp/lampvm-ocr-" + uuid.uuid4().hex + ".png"
        try:
            self.guest("/usr/sbin/screencapture", "-x", *(["-R" + region] if region else []), remote, stderr=subprocess.DEVNULL)
            # Vision in the guest reports a missing display scaler on stderr every time; other errors are passed on.
            result = subprocess.run([str(self.tart), "exec", self.name, self.helper(), "ocr", remote], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            errors = "\n".join(line for line in result.stderr.splitlines() if "AppleM2ScalerParavirtDriver" not in line)
            if errors:
                print(errors, file=sys.stderr)
            if result.returncode:
                raise Error("Reading the screen failed")
            read = json.loads(result.stdout)
        finally:
            subprocess.run([str(self.tart), "exec", self.name, "/bin/rm", "-f", remote], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if region:
            x0, y0, width, _ = map(int, region.split(","))
        else:
            x0, y0 = 0, 0
            width = int(re.search(r"now (\d+)x\d+ points", self.control("display", capture=True)).group(1))
        area = ("the window %r" % args.window if args.window else "the front window of " + app if app else "the screen")
        target = ocr_target(read["lines"], text, args.exact, args.index, read["width"] / width, area)
        x, y = x0 + target["x"], y0 + target["y"]
        glide = self.glide(args)
        self.control("rightclick" if args.right else "click", "%.1f" % x, "%.1f" % y, *(["--app", owner] if owner else []), **({"glide": glide} if glide else {}))
        report = {"ocr": target["text"], "confidence": target["confidence"], "x": round(x, 1), "y": round(y, 1)}
        if raised is False:
            report["note"] = "the guest helper is older than 5, so the window was not raised; a window that was not in front may take this click only to come forward"
        print(json.dumps(report))

    def artifact(self, args, video=False):
        self.need()
        app = args.app or self.app
        ident = uuid.uuid4().hex
        extension = ".mov" if video else ".png"
        destination = Path(args.file).expanduser() if args.file else self.state / "artifacts" / (self.name + "-" + ident + extension)
        if destination.exists():
            raise Error("Output already exists; choose a new filename")
        destination.parent.mkdir(parents=True, exist_ok=True)
        remote = "/tmp/lampvm-" + ident + extension
        # A guest whose helper cannot record keeps using screencapture, which runs its full length.
        version = self.helper_version() if video else 0
        own = version >= 3
        if video and version < 4 and args.seconds > 300:
            raise Error("This VM's guest helper records for 300 seconds at most. Clone a VM from a clean image prepared with the current helper.")
        command = [self.helper(), "record", remote, "--seconds", str(args.seconds)] if own else ["/usr/sbin/screencapture", "-x"]
        window = getattr(args, "window", None)
        if window is not None and not window.strip():
            raise Error("--window needs a title")
        if app or window:
            # Recording releases the action lock after fixing its capture region,
            # allowing input commands to run during the recording.
            with lock(self.state / "locks" / (self.name + ".lock")) if video else contextlib.nullcontext():
                if window:  # Searches every app's windows unless --app names one; a configured app does not narrow it.
                    found = self.find_window(window, args.app)
                    app, window, bounds, raised = found["app"], found["title"], found["bounds"], self.show_window(found)
                else:
                    self.control("activate", app)
                    bounds = self.control("bounds", app, capture=True)
                if not re.fullmatch(r"-?\d+,-?\d+,\d+,\d+", bounds):
                    raise Error("Invalid app window bounds: " + bounds)
                command += ["--region", bounds] if own else ["-R" + bounds]
        # Helper 5 leaves Notification Center out of recordings, so a banner, even one arriving mid-take, is never filmed.
        if not (video and version >= 5):
            self.refuse_banners(bounds if app or window else None)
        if not own:
            command += (["-v", "-V" + str(args.seconds), "-k"] if video else []) + [remote]
        partial = destination.with_name(destination.name + "." + ident + ".partial")
        entry = self.recordings_dir() / (self.name + "-" + ident + ".json")
        if video:  # Shown by `status` while it runs.
            entry.write_text(json.dumps({"vm": self.name, "file": str(destination.resolve()), "app": app, "window": window, "pid": os.getpid(),
                                         "started_at": time.time(), "limit_seconds": args.seconds, "paused": False}) + "\n")
        try:
            # Held for the length of the capture so pointer commands know to glide.
            with self.recording().open("a") if video else contextlib.nullcontext() as marker:
                if video:  # Shared: two recordings of one VM may overlap.
                    fcntl.flock(marker, fcntl.LOCK_SH)
                taken = self.guest(*command, **({"stdout": subprocess.PIPE, "text": True} if own else {}))
            with partial.open("xb") as stream:
                self.guest("/bin/cat", remote, stdout=stream)
            if partial.stat().st_size == 0:
                raise Error("Capture produced an empty file; check guest recording permission")
            # Hard-link publishes without overwriting a destination created by a
            # concurrent call; partial downloads are never exposed as proof.
            os.link(partial, destination)
        finally:
            entry.unlink(missing_ok=True)
            partial.unlink(missing_ok=True)
            subprocess.run([str(self.tart), "exec", self.name, "/bin/rm", "-f", remote], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        report = {"file": str(destination.resolve()), "app": app, "vm": self.name, "capture": "video" if video else "screenshot"}
        if window:
            report["window"] = window
            if not raised:
                report["note"] = "the guest helper is older than 5, so the window was not raised; another window of its app may cover it"
        if own:  # How long the take ran: its limit, or less when `record --stop` ended it.
            taken = json.loads(taken.stdout)
            report["seconds"] = round(taken["seconds"], 2)
            if taken.get("pausedSeconds"):  # Left out by `record --pause`; a helper before 4 has no pauses.
                report["pausedSeconds"] = round(taken["pausedSeconds"], 2)
            if taken.get("marks"):  # Made by `record --mark`; a helper before 6 has none.
                timeline = timeline_for(destination)
                timeline.write_text(json.dumps(taken["marks"], indent=1) + "\n")
                report["marks"], report["timeline"] = taken["marks"], str(timeline)
        words = [word.strip() for word in (getattr(args, "text_check", None) or "").split("|") if word.strip()]
        if words:
            checker = self.state / "bin/textcheck"
            if not checker.is_file():
                raise Error("The text checker is not built; run lampvm build. The recording is at " + report["file"])
            result = subprocess.run([str(checker), str(destination), *words], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if result.returncode not in (0, 1):
                print(json.dumps(report))
                raise Error("The text check could not be trusted, so the recording is unchecked: " + result.stderr.strip())
            report["textCheck"] = json.loads(result.stdout)
            print(json.dumps(report))
            if result.returncode:
                shown = report["textCheck"]["matches"]
                raise Error("The recording shows " + ", ".join("%r from %.1f s to %.1f s" % (m["word"], m["firstSeconds"], m["lastSeconds"]) for m in shown) +
                            ". It is kept at " + report["file"] + ": cover or delete it before sharing.")
            return
        print(json.dumps(report))

    def ocr(self, args):
        app = args.app or self.app
        remote = "/tmp/lampvm-ocr-" + uuid.uuid4().hex + ".png"
        command = ["/usr/sbin/screencapture", "-x"]
        origin, extent = {"x": 0, "y": 0}, None
        if app:
            self.control("activate", app)
            bounds = self.control("bounds", app, capture=True)
            if not re.fullmatch(r"-?\d+,-?\d+,\d+,\d+", bounds):
                raise Error("Invalid app window bounds")
            x, y, width, height = map(int, bounds.split(","))
            origin, extent = {"x": x, "y": y}, {"width": width, "height": height}
            command += ["-R" + bounds]
        try:
            self.guest(*command, remote)
            result = json.loads(self.control("ocr", remote, capture=True))
            result["screenOriginPoints"] = origin
            if extent:
                result["pixelsPerPoint"] = {"x": result["width"] / extent["width"], "y": result["height"] / extent["height"]}
            result["app"] = app
            print(json.dumps(result))
        finally:
            subprocess.run([str(self.tart), "exec", self.name, "/bin/rm", "-f", remote], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def parser():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--name", help="owned VM name (or LAMPVM_NAME)")
    p.add_argument("--config", help="JSON configuration path (or LAMPVM_CONFIG)")
    p.add_argument("--state-dir", help="external tools/logs/artifacts directory")
    sub = p.add_subparsers(dest="command")
    def add(name, help_text):
        return sub.add_parser(name, help=help_text)
    def app_option(q):
        q.add_argument("--app", help="target application; overrides config")
    add("help", "show commands")
    q = add("setup", "download, build and provision an owned VM")
    q.add_argument("--from", dest="source")
    q.add_argument("--image")
    q.add_argument("--no-download", action="store_true")
    q.add_argument("--wait-slot", type=int, default=0)
    add("build", "build host and guest helpers into external state")
    q = add("video", "cut a recording into a movie worth watching: still stretches played fast, marks drawn as captions; no VM needed")
    q.add_argument("source", help="the recording, such as take.mov")
    q.add_argument("file", help="the movie to write, .mp4 or .mov; must be new")
    q.add_argument("--timeline", help="marks to caption, a JSON list of {seconds, text}; default: the recording's own, SOURCE's take.timeline.json")
    q.add_argument("--condense", type=float, default=0, metavar="SECONDS", help="play any stretch that stands still for at least this long fast, with a badge saying how long it was; 0 keeps real time")
    q.add_argument("--hold", type=float, default=1.0, metavar="SECONDS", help="real time kept at the start of each condensed stretch, so the viewer reads what the screen reached (default 1)")
    q.add_argument("--crop", metavar="X,Y,W,H", help="keep only this part of the picture, in the movie's pixels (twice the points `bounds` reports on a Retina guest)")
    q.add_argument("--width", type=int, help="scale the result to this many pixels wide; never upscales")
    add("doctor", "check host dependencies and guest permissions")
    q = add("start", "boot an owned VM headlessly; returns when it is ready for commands")
    q.add_argument("--wait", type=float, default=0, help="seconds to wait for a VM slot")
    q.add_argument("--session", help="task or thread id shared by every start of one session (or LAMPVM_SESSION); status groups by it")
    q.add_argument("--owner", help="free description shown beside holder and ticket")
    q.add_argument("--idle-after", type=float, default=600, help="flag command silence after seconds; never stops the VM")
    q.add_argument("--detach", action="store_true", help="return after queuing instead of when the VM is ready; rerun start without it to wait")
    add("stop", "shut down only the selected owned VM")
    q = add("status", "show all slot holders and durable FIFO queue")
    q.add_argument("--json", action="store_true")
    q = add("view", "open a running VM in a window on this Mac, to watch or use by hand")
    q.add_argument("vm", nargs="?", help="VM to show; defaults to the selected VM, else the only one running")
    add("cancel-start", "cancel only the selected VM's queued start")
    q = add("hold", "declare guest work without lampvm commands")
    q.add_argument("--seconds", type=float, required=True)
    q.add_argument("--reason", required=True)
    add("release-hold", "clear selected VM's declared hold")
    add("apps", "list guest applications and their process names")
    app_option(add("ocr", "read visible text and image coordinates with offline Vision OCR"))
    q = add("clone", "make a private stopped VM from a stopped source")
    q.add_argument("target")
    q.add_argument("--from", dest="source", help="source VM; defaults to configured clean copy")
    q = add("destroy", "delete only the selected owned VM")
    q.add_argument("--yes", action="store_true", required=True)
    q = add("reset", "replace owned VM with its clean copy; a running VM reboots in the slot it holds")
    q.add_argument("--yes", action="store_true", required=True)
    q = add("install", "copy a built .app into guest /Applications")
    q.add_argument("source")
    q = add("launch", "open an app with optional arguments")
    q.add_argument("app", nargs="?")
    q.add_argument("args", nargs=argparse.REMAINDER)
    q = add("quit", "ask an app to quit")
    q.add_argument("app", nargs="?")
    q = add("openrouter", "give the guest's Lamp the host's OpenRouter key and the configured test model")
    q.add_argument("app", nargs="?", help="configured app; defaults to the first, Lamp Dev")
    q.add_argument("--model", help="provider/model id instead of the configured one")
    q = add("wipe", "clear only paths and domains configured for this app")
    q.add_argument("--yes", action="store_true", required=True)
    for name in ["shot", "record"]:
        q = add(name, "capture the guest screen or an app window")
        q.add_argument("file", nargs="?")
        app_option(q)
        q.add_argument("--window", help="crop to the window with this title (exact, else the one title containing it), in any app unless --app is given")
        if name == "record":
            q.add_argument("--seconds", type=int, default=5, help="longest the recording runs, paused time included (1-%s)" % RECORD_LIMIT)
            signals = q.add_mutually_exclusive_group()
            signals.add_argument("--stop", action="store_true", help="end this VM's running recordings now; each waiting record call then saves its movie")
            signals.add_argument("--pause", action="store_true", help="leave what happens next out of this VM's running recordings until --resume")
            signals.add_argument("--mark", metavar="TEXT", help="name this moment in this VM's running recordings; the marks come back with the movie and `video` draws them")
            q.add_argument("--text-check", metavar="WORDS", help="afterwards, read the movie's frames and fail if any of these |-separated words show")
            signals.add_argument("--resume", action="store_true", help="carry on a paused recording; the movie goes on from the moment of pausing without a gap")
    for name in ["tree", "windows", "bounds", "activate"]:
        q = add(name, "inspect or activate an application")
        q.add_argument("app", nargs="?")
        if name == "tree":
            q.add_argument("--json", action="store_true")
    for name in ["find", "clickon", "press", "wait", "assert", "setvalue"]:
        q = add(name, "target an accessible element by label")
        q.add_argument("operands", nargs="+", help="[APP] TEXT" + (" VALUE" if name == "setvalue" else ""))
        app_option(q)
        q.add_argument("--exact", action="store_true")
        q.add_argument("--role", help="Accessibility role filter, e.g. AXButton")
        if name == "find":
            q.add_argument("--json", action="store_true")
        if name in ["wait", "assert"]:
            q.add_argument("--absent", action="store_true")
            q.add_argument("--timeout", type=float, default=10 if name == "wait" else 0)
        if name in ["clickon", "press", "setvalue"]:
            q.add_argument("--index", type=int)
        if name == "clickon":
            q.add_argument("--right", action="store_true")
            q.add_argument("--glide", action="store_true", help=GLIDE)
            q.add_argument("--ocr", action="store_true", help="find TEXT by reading the screen, for buttons Accessibility cannot see")
            q.add_argument("--window", help="with --ocr, read only the window with this title")
    for name, count in [("click", 2), ("doubleclick", 2), ("rightclick", 2), ("move", 2), ("hit", 2), ("scroll", 3), ("drag", 4)]:
        q = add(name, "inspect the accessible element under a point" if name == "hit" else "send real guest mouse events")
        q.add_argument("values", nargs="+", type=float)
        app_option(q)
        if name != "hit":
            q.add_argument("--glide", action="store_true", help=GLIDE)
    q = add("type", "type Unicode into the focused control")
    q.add_argument("text")
    app_option(q)
    q = add("key", "send a supported key with optional modifiers")
    q.add_argument("key")
    q.add_argument("modifiers", nargs="?")
    app_option(q)
    q = add("exec", "execute a guest program (no shell expansion)")
    q.add_argument("args", nargs=argparse.REMAINDER)
    add("sh", "execute a zsh script from standard input")
    for name in ["push", "pull"]:
        q = add(name, "transfer a file" + (" or folder into the guest" if name == "push" else " out of the guest"))
        q.add_argument("source")
        q.add_argument("destination")
    return p


def main():
    p = parser()
    args = p.parse_args()
    if args.command in [None, "help"]:
        p.print_help()
        return
    vm = VM(args)
    cmd = args.command
    if cmd == "build":
        run([ROOT / "bin/build"], env={**os.environ, "LAMPVM_STATE_DIR": str(vm.state)})
        return
    if cmd == "video":
        editor = vm.state / "bin/videoedit"
        if not editor.is_file():
            raise Error("The video editor is not built; run lampvm build")
        source = Path(args.source).expanduser()
        if not source.is_file():
            raise Error("No recording at " + str(source))
        timeline = Path(args.timeline).expanduser() if args.timeline else timeline_for(source)
        if args.timeline and not timeline.is_file():
            raise Error("No timeline at " + str(timeline))
        if args.crop and not re.fullmatch(r"\d+,\d+,[1-9]\d*,[1-9]\d*", args.crop):
            raise Error("--crop needs X,Y,WIDTH,HEIGHT in pixels")
        if args.condense < 0 or args.hold < 0 or (args.width is not None and args.width < 2):
            raise Error("--condense and --hold are seconds, --width is pixels")
        argv = [str(editor), str(source), str(Path(args.file).expanduser()), "--condense", str(args.condense), "--hold", str(args.hold)]
        if timeline.is_file():
            argv += ["--timeline", str(timeline)]
        if args.crop:
            argv += ["--crop", args.crop]
        if args.width:
            argv += ["--width", str(args.width)]
        run(argv)
        return
    if cmd == "setup":
        argv = [sys.executable, ROOT / "lib/setup.py", "--state-dir", vm.state, "--name", vm.name]
        if args.config:
            argv += ["--config", args.config]
        if args.source:
            argv += ["--from", args.source]
        if args.image:
            argv += ["--image", args.image]
        if args.no_download:
            argv += ["--no-download"]
        run(argv + ["--wait-slot", str(args.wait_slot)])
        return
    if cmd == "doctor":
        problems = []
        checks = {"architecture": output(["/usr/bin/uname", "-m"]), "macos": output(["/usr/bin/sw_vers", "-productVersion"]), "state": str(vm.state), "tart": str(vm.tart), "vm": vm.name}
        if checks["architecture"] != "arm64":
            problems.append("Apple Silicon is required")
        if int(checks["macos"].split(".")[0]) < 14:
            problems.append("macOS 14+ required for tart exec")
        for tool in ["lockstate", "textcheck", "videoedit", "vmctl"]:
            if not (vm.state / "bin" / tool).is_file():
                problems.append("missing built helper: " + tool)
        if not vm.tart.is_file():
            problems.append("Tart is missing")
        elif vm.running():
            try:
                checks["accessibility"] = vm.control("trusted", capture=True)
                problems.extend(vm.health())
            except Error:
                problems.append("guest Accessibility isn't granted")
        checks["problems"] = problems
        print(json.dumps(checks, indent=2))
        if problems:
            raise Error("doctor found problems; see report")
        return
    vm.require_tart()
    # Recording and waits deliberately release the action lock so another call
    # can cause the change they observe. Captures have unique names on both sides.
    unlocked = cmd in ["start", "view", "record", "wait", "assert", "status", "tree", "find", "windows", "bounds"]
    lifecycle_names = [vm.name]
    if cmd == "clone":
        lifecycle_names = [valid_name(args.target), valid_name(args.source or vm.clean)]
    if cmd == "reset":
        vm.working()
        lifecycle_names += [valid_name(json.loads(vm.marker().read_text()).get("clean", vm.clean))]
    with contextlib.nullcontext() if unlocked else locks(vm.state, lifecycle_names):
        if cmd == "start":
            if not math.isfinite(args.wait) or not 0 <= args.wait <= 86400:
                raise Error("--wait must be finite and 0..86400 seconds")
            if not math.isfinite(args.idle_after) or not 1 <= args.idle_after <= 86400:
                raise Error("--idle-after must be finite and 1..86400 seconds")
            session = args.session or os.environ.get("LAMPVM_SESSION")
            vm.start(args.wait, args.owner, args.idle_after, args.detach, valid_session(session) if session else None)
            return
        if cmd == "view":
            vm.view(args.vm or args.name or os.environ.get("LAMPVM_NAME"))
            return
        if cmd == "cancel-start":
            vm.working()
            Slots(vm.state).cancel(vm.name)
            print("cancelled queued start: " + vm.name)
            return
        if cmd in ("hold", "release-hold"):
            vm.need()
            seconds = args.seconds if cmd == "hold" else 0
            if cmd == "hold" and (not math.isfinite(seconds) or not 1 <= seconds <= 86400 or not args.reason.strip()):
                raise Error("hold requires 1..86400 finite seconds and a nonempty reason")
            Slots(vm.state).hold(vm.name, seconds, args.reason if cmd == "hold" else "")
            print("hold updated: " + vm.name)
            return
        if cmd == "stop":
            Slots(vm.state).cancel(vm.name)
            vm.stop()
            Slots(vm.state).stopped(vm.name)
            return
        if cmd == "status":
            # Tart is the authority on what runs; settle tickets against it first.
            Slots(vm.state).reap(vm.machines)
            Slots(vm.state).prune(vm.machines)
            report = Slots(vm.state).report(vm.machines())
            recordings = vm.recordings()
            for holder in report['holders']:
                holder['recordings'] = [r for r in recordings if r['vm'] == holder['name']]
            helper = vm.state / "bin/lockstate"
            if helper.exists():
                report['host_screen'] = output([helper])
            if args.json:
                print(json.dumps(report, indent=2))
            else:
                print("Slots: %s/2 running. ETA unknown." % len(report['holders']))
                for holder in report['holders']:
                    since = time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(holder['started_at'])) if holder.get('started_at') else 'unknown'
                    print("  %s | session %s | owner %s | since %s | idle %ss | %s | monitor %s%s" %
                          (holder['name'], holder['session'] or '-', holder.get('owner', 'unknown'), since,
                           holder['idle_seconds'] if holder['idle_seconds'] is not None else '?', holder['attention'], holder['monitor'],
                           " | resets %s" % holder['resets'] if holder.get('resets') else ""))
                    for take in holder['recordings']:
                        print("    recording %ss of up to %ss%s%s -> %s" % (take['running_seconds'], take['limit_seconds'],
                              " (paused)" if take['paused'] else "", " of " + (take['window'] or take['app']) if take['window'] or take['app'] else " of the desktop", take['file']))
                print("Queue:")
                for ticket in report['queue']:
                    print("  #%s %s | session %s | owner %s | waited %ss | remaining %ss | %s" %
                          (ticket['position'], ticket['name'], ticket['session'] or '-', ticket['owner'], ticket['waited_seconds'],
                           ticket['remaining_seconds'], ticket['worker']))
                if not report['queue']:
                    print("  empty")
                if report['sessions']:
                    print("Sessions:")
                for group in report['sessions']:
                    print("  %s: %s" % (group['session'] or 'no session id', "; ".join(
                        ["running " + name for name in group['running']] +
                        ["queued #%s %s" % (ticket['position'], ticket['name'])
                         for ticket in report['queue'] if ticket['name'] in group['queued']])))
                for request in report['requests']:
                    if request['phase'] in ('booting', 'failed', 'expired', 'cancelled'):
                        print("  %s: %s %s" % (request['name'], request['phase'], request.get('error', '')))
            return
        if cmd == "clone":
            target = valid_name(args.target)
            source = valid_name(args.source or vm.clean)
            with contextlib.nullcontext():
                if vm.exists(target) or vm.marker(target).exists():
                    raise Error("Target already exists; nothing replaced")
                src = [v for v in vm.machines() if v["Name"] == source and v.get("Source") == "local"]
                if not src or src[0].get("Running"):
                    raise Error("Clone source must be an existing stopped VM")
                vm.t("clone", source, target)
                vm.marker(target).parent.mkdir(parents=True, exist_ok=True)
                record = {"name": target, "clean": source, "source": source}
                if vm.marker(source).exists():
                    source_record = json.loads(vm.marker(source).read_text())
                    if "panic_reports" in source_record:
                        record["panic_reports"] = source_record["panic_reports"]
                vm.marker(target).write_text(json.dumps(record) + "\n")
                print("cloned: " + target)
            return
        if cmd == "destroy":
            vm.working()
            Slots(vm.state).cancel(vm.name)
            vm.stop()
            Slots(vm.state).stopped(vm.name)
            vm.t("delete", vm.name)
            vm.marker().unlink()
            print("deleted: " + vm.name)
            return
        if cmd == "reset":
            vm.working()
            clean = valid_name(json.loads(vm.marker().read_text()).get("clean", vm.clean))
            if clean == vm.name:
                raise Error("Clean copy and working VM must differ")
            source = [v for v in vm.machines() if v["Name"] == clean and v.get("Source") == "local"]
            if not source or source[0].get("Running"):
                raise Error("Clean copy must exist and be stopped")
            vm.reset(clean)
            return
        vm.need()
        with Slots(vm.state).activity(vm.name, cmd):
            if cmd == "record" and (args.stop or args.pause or args.resume or args.mark is not None) and (args.text_check is not None or args.window is not None or args.file):
                raise Error("--stop, --pause, --resume and --mark act on the running recordings; give FILE, --window and --text-check to the record call that starts one")
            if cmd == "record" and args.mark is not None:
                vm.mark_recording(args.mark)
            elif cmd == "record" and (args.stop or args.pause or args.resume):
                vm.signal_recording("stop" if args.stop else "pause" if args.pause else "resume")
            elif cmd in ["shot", "record"]:
                if cmd == "record" and not 1 <= args.seconds <= RECORD_LIMIT:
                    raise Error("Record duration must be 1..%s seconds" % RECORD_LIMIT)
                if cmd == "record" and args.text_check is not None and not any(word.strip() for word in args.text_check.split("|")):
                    raise Error("--text-check needs at least one word to look for, such as 'name@example.com|Company'")
                vm.artifact(args, cmd == "record")
            elif cmd == "ocr":
                vm.ocr(args)
            elif cmd == "apps":
                vm.control("apps")
            elif cmd == "install":
                src = Path(args.source).expanduser().resolve()
                if not src.is_dir() or src.suffix != ".app" or not (src / "Contents/Info.plist").is_file():
                    raise Error("Install expects a built .app bundle with Contents/Info.plist")
                vm.control("quit", src.stem)
                script = '''set -eu
staging=$(/usr/bin/mktemp -d /tmp/lampvm-install.XXXXXXXX)
mkdir -p "$staging/new" "$staging/old"
/usr/bin/tar -xf - -C "$staging/new"
[[ ! -e "/Applications/$1" ]] || mv -- "/Applications/$1" "$staging/old/"
mv -- "$staging/new/$1" /Applications/
/usr/bin/xattr -cr "/Applications/$1"
'''
                vm.pipe_tar(src, script, src.name)
                print("installed: " + src.name)
            elif cmd == "launch":
                app = vm.application(args.app)
                path = "/Applications/" + app + ".app"
                exists = subprocess.run([str(vm.tart), "exec", vm.name, "/bin/test", "-d", path]).returncode == 0
                argv = ["/usr/bin/open", "-a", path if exists else app]
                launch_args = args.args[1:] if args.args[:1] == ["--"] else args.args
                if launch_args:
                    argv += ["--args", *launch_args]
                vm.guest(*argv)
            elif cmd == "quit":
                vm.control("quit", vm.application(args.app))
            elif cmd == "openrouter":
                vm.openrouter(args.app, args.model)
            elif cmd == "wipe":
                wipe = vm.config.get("wipe", {})
                domains, paths = wipe.get("preference_domains", []), wipe.get("paths", [])
                if not domains and not paths:
                    raise Error("No wipe paths/domains configured; nothing removed")
                if any(not re.fullmatch(r"[A-Za-z0-9._-]+", x) for x in domains):
                    raise Error("Invalid preference domain")
                if any(not x.startswith(("Library/Application Support/", "Applications/")) or ".." in Path(x).parts for x in paths):
                    raise Error("Wipe paths must be relative app-data paths under Library/Application Support or Applications")
                vm.control("quit", vm.application())
                for domain in domains:
                    subprocess.run([str(vm.tart), "exec", vm.name, "/usr/bin/defaults", "delete", domain], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                script = 'set -eu; staging=$(mktemp -d /tmp/lampvm-wipe.XXXXXXXX); cd "$HOME"; for p in "$@"; do [[ ! -e "$p" ]] || mv -- "$p" "$staging/${RANDOM}-${p:t}"; done'
                vm.guest("/bin/zsh", "-c", script, "lampvm", *paths)
                print("wiped configured app preferences and data (not Keychain)")
            elif cmd in ["tree", "windows", "bounds", "activate"]:
                argv = [cmd, vm.application(args.app)]
                if getattr(args, "json", False):
                    argv.append("--json")
                vm.control(*argv)
            elif cmd == "clickon" and args.ocr:
                if len(args.operands) not in (1, 2):
                    raise Error("Expected [APP] TEXT")
                # Without an app, the whole screen is read.
                vm.ocr_click(args.operands[0] if len(args.operands) == 2 else args.app or vm.app, args.operands[-1], args)
            elif cmd == "clickon" and args.window is not None:
                raise Error("--window on clickon needs --ocr")
            elif cmd in ["find", "clickon", "press", "wait", "assert", "setvalue"]:
                count = 2 if cmd == "setvalue" else 1
                if len(args.operands) == count:
                    app, operands = vm.application(), args.operands
                elif len(args.operands) == count + 1:
                    app, operands = args.operands[0], args.operands[1:]
                else:
                    raise Error("Expected [APP] TEXT" + (" VALUE" if count == 2 else ""))
                argv = [cmd, app, *operands]
                for flag in ["exact", "json", "right", "absent"]:
                    if getattr(args, flag, False):
                        argv.append("--" + flag)
                if getattr(args, "index", None) is not None:
                    argv += ["--index", str(args.index)]
                if args.role:
                    argv += ["--role", args.role]
                if hasattr(args, "timeout"):
                    if not math.isfinite(args.timeout) or not 0 <= args.timeout <= 3600:
                        raise Error("Timeout must be 0..3600 seconds")
                    argv += ["--timeout", str(args.timeout)]
                glide = vm.glide(args) if cmd == "clickon" else None
                vm.control(*argv, **({"glide": glide} if glide else {}))
            elif cmd in ["click", "doubleclick", "rightclick", "move", "hit", "scroll", "drag", "type", "key"]:
                if hasattr(args, "values"):
                    allowed = {"click": (2,), "doubleclick": (2,), "rightclick": (2,), "move": (2,), "hit": (2,), "scroll": (3, 4), "drag": (4, 5)}[cmd]
                    if len(args.values) not in allowed or not all(math.isfinite(v) and abs(v) <= 1_000_000 for v in args.values):
                        raise Error("Wrong number of coordinates or numeric value outside +/-1000000")
                values = [args.text] if cmd == "type" else ([args.key] + ([args.modifiers] if args.modifiers else [])) if cmd == "key" else [str(x) for x in args.values]
                # The helper brings the app forward itself, saving a guest call per action.
                options = ["--app", vm.app] if vm.app and cmd != "hit" else []
                glide = vm.glide(args) if hasattr(args, "values") and cmd != "hit" else None
                vm.control(cmd, *values, *options, **({"glide": glide} if glide else {}))
            elif cmd == "exec":
                if not args.args:
                    raise Error("exec needs a command")
                vm.require_tart()
                vm.watched("exec", vm.name, *args.args)
            elif cmd == "sh":
                vm.watched("exec", "-i", vm.name, "/bin/zsh", "-s")
            elif cmd == "push":
                vm.push(args.source, args.destination)
                print("copied into guest: " + args.destination)
            elif cmd == "pull":
                dest = Path(args.destination).expanduser()
                if dest.exists():
                    raise Error("Destination exists; choose a new filename")
                partial = dest.with_name(dest.name + "." + uuid.uuid4().hex + ".partial")
                try:
                    with partial.open("xb") as stream:
                        vm.guest("/bin/cat", args.source, stdout=stream)
                    os.link(partial, dest)
                finally:
                    partial.unlink(missing_ok=True)
                print(str(dest))



if __name__ == "__main__":
    try:
        main()
    except (Error, RuntimeError, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print("lampvm: " + str(error), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("lampvm: interrupted; the owned VM may still be running", file=sys.stderr)
        sys.exit(130)
